      "status": "verified",
      "core_facts": [
        {"fact": "人类mtDNA约16500碱基对、37个基因，其中13个编码氧化磷酸化相关蛋白。", "status": "verified", "sources": ["https://www.medlineplus.gov/genetics/chromosome/mitochondrial-dna/", "https://www.ncbi.nlm.nih.gov/books/NBK27914/"]},
        {"fact": "线粒体源于约20亿年前的细菌内共生事件，是当前主流且有分子系统发育支持的解释。", "status": "verified", "sources": ["https://www.nature.com/articles/s41586-021-03297-6", "https://www.nature.com/articles/srep07949"]},
        {"fact": "人类线粒体和mtDNA通常主要经母系遗传。", "status": "verified", "sources": ["https://www.genome.gov/genetics-glossary/Mitochondria", "https://www.ncbi.nlm.nih.gov/books/NBK27914/", "https://pubmed.ncbi.nlm.nih.gov/23524114/"]}
